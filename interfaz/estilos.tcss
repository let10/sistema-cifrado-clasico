Screen {
    background: #120a1f;
    color: #ede9fe;
    align: center middle;
}

/* -------- MENU PRINCIPAL -------- */

.contenedor-menu {
    width: auto;
    height: auto;
    align: center middle;
    padding: 1 2;
}

.titulo {
    text-style: bold;
    color: #c4b5fd;
    text-align: center;
    width: auto;
}

.subtitulo {
    color: #a78bfa;
    text-align: center;
    width: auto;
    margin-bottom: 1;
}

.panel-menu {
    width: 44;
    height: auto;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 2;
}

.panel-menu Button {
    width: 100%;
    margin-bottom: 1;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.panel-menu Button:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.panel-menu Button:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

/* -------- MODULOS -------- */

.contenedor-modulo {
    width: 100;
    height: auto;
    max-height: 95%;
    align: center middle;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
}

.nombre-modulo {
    text-style: bold;
    color: #c4b5fd;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.mensaje-pendiente {
    color: #ede9fe;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.etiqueta {
    color: #c9b6ff;
    margin-top: 1;
}

Input {
    border: round #7b5cff;
    background: #120a1f;
    color: #ede9fe;
    width: 100%;
}

Input:focus {
    border: round #b794ff;
}

.fila-botones {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

.encabezado-clave {
    width: 100%;
    height: auto;
    align: left bottom;
}

.encabezado-clave .etiqueta {
    width: 1fr;
}

.encabezado-estado {
    width: 8;
    text-align: center;
    color: #a8a0b5;
    text-style: bold;
}

.encabezado-estado.procedimiento-activo {
    color: #d8b4fe;
}

.fila-clave {
    width: 100%;
    height: auto;
    align: left middle;
}

.fila-clave .input-clave {
    width: 1fr;
}

.switch-procedimiento {
    width: 8;
    border: tall #79658f;
    background: #2e2340;
    padding: 0 1;
}

.switch-procedimiento .switch--slider {
    color: #d8cde6;
    background: #554768;
}

.switch-procedimiento.-on {
    border: tall #c4b5fd;
    background: #5b21b6;
}

.switch-procedimiento.-on .switch--slider {
    color: #ffffff;
    background: #a78bfa;
}

.fila-botones Button {
    width: 1fr;
    margin: 0 1;
    background: #6d28d9;
    color: #ffffff;
    border: round #c4b5fd;
    text-style: bold;
}

.fila-botones Button:hover {
    background: #7c3aed;
}

.fila-botones Button:focus {
    background: #a78bfa;
    border: round #ffffff;
}

.panel-resultado {
    height: 14;
    margin-top: 1;
    padding: 1;
    background: #120a1f;
    border: round #7b5cff;
}

.panel-vigenere {
    height: 6;
}

.panel-resultado Static {
    color: #ede9fe;
}

.contenedor-modulo > Button {
    width: 100%;
    margin-top: 1;
    background: #1b1030;
    color: #c4b5fd;
    border: round #5b21b6;
    text-style: bold;
}

.contenedor-modulo > Button:focus {
    background: #5b21b6;
    color: #ffffff;
    border: round #c4b5fd;
}

/* -------- FOOTER -------- */

Footer {
    background: #1b1030;
    color: #c4b5fd;
}

Header {
    background: #1b1030;
    color: #c4b5fd;
}

/* Pantalla de algoritmo (Playfair y futuros módulos con formulario) */

.panel-algoritmo {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
    overflow-y: auto;
}

.etiqueta-campo {
    color: #a78bfa;
    text-style: bold;
    margin-top: 1;
}

#selector_operacion {
    width: 100%;
    height: auto;
    background: #140b22;
    border: round #7c3aed;
    margin-top: 1;
}

#selector_operacion RadioButton {
    background: #140b22;
    color: #ede9fe;
}

#selector_operacion RadioButton:focus {
    background: #3b1d63;
}

.fila-botones {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.boton-accion {
    width: 1fr;
    margin-right: 1;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.boton-accion:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.boton-accion:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

.boton-secundario {
    width: 100%;
    margin-top: 1;
    background: #1b1030;
    color: #c4b5fd;
    border: round #5b21b6;
    text-style: bold;
}

.boton-secundario:hover {
    background: #3b1d63;
    border: round #a78bfa;
}

.boton-secundario:focus {
    background: #5b21b6;
    color: #ffffff;
    border: round #c4b5fd;
}

.boton-secundario:disabled {
    color: #5b4a78;
    border: round #3b1d63;
}

.panel-resultado {
    width: 100%;
    height: auto;
    background: #15091f;
    border: round #4c1d95;
    padding: 1 2;
    margin-top: 1;
    color: #ede9fe;
}

.texto-advertencia {
    width: 100%;
    height: auto;
    color: #fbbf24;
    margin-top: 1;
}

.mensaje-error {
    width: 100%;
    height: auto;
    color: #f87171;
    text-style: bold;
    margin-top: 1;
}

/* Pantalla de visualización paso a paso (Playfair) */

.panel-pasos {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
}

.indicador-progreso {
    width: 100%;
    color: #a78bfa;
    text-align: center;
    margin-bottom: 1;
}

.procedimiento-algoritmo {
    width: 100;
    height: 95%;
    max-width: 100%;
    max-height: 100%;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
}

.explicacion-paso {
    width: 100%;
    height: auto;
    color: #ede9fe;
    background: #15091f;
    border-left: thick #7c3aed;
    padding: 1 2;
    margin-bottom: 1;
}

.procedimiento-algoritmo DataTable {
    width: 100%;
    height: 1fr;
    background: #15091f;
    border: round #4c1d95;
    color: #ede9fe;
}

.procedimiento-algoritmo DataTable > .datatable--header {
    background: #3b1d63;
    color: #ffffff;
    text-style: bold;
}

.procedimiento-algoritmo DataTable > .datatable--cursor {
    background: #6d28d9;
    color: #ffffff;
}

.procedimiento-algoritmo .fila-controles-paso {
    width: 100%;
    height: auto;
    margin-top: 1;
}

/* Solo el contenido del paso hace scroll; los controles de abajo
   (ANTERIOR/SIGUIENTE/MOSTRAR TODO/VOLVER) quedan siempre visibles. */
.contenido-paso-scroll {
    width: 100%;
    height: 22;
    margin-bottom: 1;
}

.titulo-paso {
    width: 100%;
    color: #c4b5fd;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

.contenido-paso {
    width: 100%;
    height: auto;
    background: #15091f;
    border: round #4c1d95;
    padding: 1 2;
    margin-bottom: 1;
    color: #ede9fe;
}

.fila-controles-paso {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.boton-control {
    width: 1fr;
    margin-right: 1;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.boton-control:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.boton-control:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

.boton-control:disabled {
    color: #5b4a78;
    border: round #3b1d63;
}

/* Centrado del menú principal */
PantallaMenuPrincipal {
    align: center middle;
}

PantallaMenuPrincipal .contenedor-principal {
    width: auto;
    height: auto;
    max-width: 100%;
    align: center middle;
}
