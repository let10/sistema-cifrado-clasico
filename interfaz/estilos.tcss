Screen {
    background: #120a1f;
    color: #ede9fe;
    align: center middle;
}

/* -------- MENU PRINCIPAL -------- */

.contenedor-menu {
    width: auto;
    height: auto;
    align: center middle;
    padding: 1 2;
}

.titulo {
    text-style: bold;
    color: #c4b5fd;
    text-align: center;
    width: auto;
}

.subtitulo {
    color: #a78bfa;
    text-align: center;
    width: auto;
    margin-bottom: 1;
}

.panel-menu {
    width: 44;
    height: auto;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 2;
}

.panel-menu Button {
    width: 100%;
    margin-bottom: 1;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.panel-menu Button:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.panel-menu Button:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

/* -------- MODULOS -------- */

.contenedor-modulo {
    width: 100;
    height: auto;
    max-height: 95%;
    align: center middle;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
}

.nombre-modulo {
    text-style: bold;
    color: #c4b5fd;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.mensaje-pendiente {
    color: #ede9fe;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.etiqueta {
    color: #c9b6ff;
    margin-top: 1;
}

Input {
    border: round #7b5cff;
    background: #120a1f;
    color: #ede9fe;
    width: 100%;
}

Input:focus {
    border: round #b794ff;
}

.fila-botones {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

.encabezado-clave {
    width: 100%;
    height: auto;
    align: left bottom;
}

.encabezado-clave .etiqueta {
    width: 1fr;
}

.encabezado-estado {
    width: 8;
    text-align: center;
    color: #a8a0b5;
    text-style: bold;
}

.encabezado-estado.procedimiento-activo {
    color: #d8b4fe;
}

.fila-clave {
    width: 100%;
    height: auto;
    align: left middle;
}

.fila-clave .input-clave {
    width: 1fr;
}

.switch-procedimiento {
    width: 8;
    border: tall #79658f;
    background: #2e2340;
    padding: 0 1;
}

.switch-procedimiento .switch--slider {
    color: #d8cde6;
    background: #554768;
}

.switch-procedimiento.-on {
    border: tall #c4b5fd;
    background: #5b21b6;
}

.switch-procedimiento.-on .switch--slider {
    color: #ffffff;
    background: #a78bfa;
}

.fila-botones Button {
    width: 1fr;
    margin: 0 1;
    background: #6d28d9;
    color: #ffffff;
    border: round #c4b5fd;
    text-style: bold;
}

.fila-botones Button:hover {
    background: #7c3aed;
}

.fila-botones Button:focus {
    background: #a78bfa;
    border: round #ffffff;
}

.panel-resultado {
    height: 14;
    margin-top: 1;
    padding: 1;
    background: #120a1f;
    border: round #7b5cff;
}

.panel-vigenere {
    height: 8;
}

.panel-resultado Static {
    color: #ede9fe;
}

.contenedor-modulo > Button {
    width: 100%;
    margin-top: 1;
    background: #1b1030;
    color: #c4b5fd;
    border: round #5b21b6;
    text-style: bold;
}

.contenedor-modulo > Button:focus {
    background: #5b21b6;
    color: #ffffff;
    border: round #c4b5fd;
}

/* -------- FOOTER -------- */

Footer {
    background: #1b1030;
    color: #c4b5fd;
}

Header {
    background: #1b1030;
    color: #c4b5fd;
}
