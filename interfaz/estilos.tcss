/* Tema oscuro violeta del Sistema de Encriptación Clásica */

Screen {
    background: #120a1f;
    color: #ede9fe;
    align: center middle;
}

.contenedor-principal {
    width: auto;
    height: auto;
    align: center middle;
    padding: 1 4;
}

.titulo {
    text-style: bold;
    color: #c4b5fd;
    text-align: center;
    width: 100%;
    content-align: center middle;
}

.subtitulo {
    color: #a78bfa;
    text-align: center;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

.panel-menu {
    width: 50;
    height: auto;
    background: #1b1030;
    border: round #7c3aed;
    padding: 0 3;
    align: center middle;
}

.grupo-botones {
    width: 100%;
    height: auto;
    align: center middle;
}

.boton-menu {
    width: 100%;
    margin-bottom: 0;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.boton-menu:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.boton-menu:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

.boton-salir {
    width: 100%;
    margin-top: 0;
    background: #1b1030;
    color: #c4b5fd;
    border: round #5b21b6;
    text-style: bold;
}

.boton-salir:hover {
    background: #3b1d63;
    border: round #a78bfa;
}

.boton-salir:focus {
    background: #5b21b6;
    color: #ffffff;
    border: round #c4b5fd;
}

.panel-modulo {
    width: 60;
    height: auto;
    background: #1b1030;
    border: round #7c3aed;
    padding: 2 4;
    align: center middle;
}

.nombre-modulo {
    text-style: bold;
    color: #c4b5fd;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.mensaje-pendiente {
    color: #ede9fe;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.responsable-modulo {
    color: #a78bfa;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

Footer {
    background: #1b1030;
    color: #c4b5fd;
}

Header {
    background: #1b1030;
    color: #c4b5fd;
}

/* Pantalla de algoritmo (Playfair y futuros módulos con formulario) */

.panel-algoritmo {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
    overflow-y: auto;
}

.etiqueta-campo {
    color: #a78bfa;
    text-style: bold;
    margin-top: 1;
}

#selector_operacion {
    width: 100%;
    height: auto;
    background: #140b22;
    border: round #7c3aed;
    margin-top: 1;
}

#selector_operacion RadioButton {
    background: #140b22;
    color: #ede9fe;
}

#selector_operacion RadioButton:focus {
    background: #3b1d63;
}

.fila-botones {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.boton-accion {
    width: 1fr;
    margin-right: 1;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.boton-accion:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.boton-accion:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

.boton-secundario {
    width: 100%;
    margin-top: 1;
    background: #1b1030;
    color: #c4b5fd;
    border: round #5b21b6;
    text-style: bold;
}

.boton-secundario:hover {
    background: #3b1d63;
    border: round #a78bfa;
}

.boton-secundario:focus {
    background: #5b21b6;
    color: #ffffff;
    border: round #c4b5fd;
}

.boton-secundario:disabled {
    color: #5b4a78;
    border: round #3b1d63;
}

.panel-resultado {
    width: 100%;
    height: auto;
    background: #15091f;
    border: round #4c1d95;
    padding: 1 2;
    margin-top: 1;
    color: #ede9fe;
}

.texto-advertencia {
    width: 100%;
    height: auto;
    color: #fbbf24;
    margin-top: 1;
}

.mensaje-error {
    width: 100%;
    height: auto;
    color: #f87171;
    text-style: bold;
    margin-top: 1;
}

/* Pantalla de visualización paso a paso (Playfair) */

.panel-pasos {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: #1b1030;
    border: round #7c3aed;
    padding: 1 3;
}

.indicador-progreso {
    width: 100%;
    color: #a78bfa;
    text-align: center;
    margin-bottom: 1;
}

/* Solo el contenido del paso hace scroll; los controles de abajo
   (ANTERIOR/SIGUIENTE/MOSTRAR TODO/VOLVER) quedan siempre visibles. */
.contenido-paso-scroll {
    width: 100%;
    height: 22;
    margin-bottom: 1;
}

.titulo-paso {
    width: 100%;
    color: #c4b5fd;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

.contenido-paso {
    width: 100%;
    height: auto;
    background: #15091f;
    border: round #4c1d95;
    padding: 1 2;
    margin-bottom: 1;
    color: #ede9fe;
}

.fila-controles-paso {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.boton-control {
    width: 1fr;
    margin-right: 1;
    background: #2e1a4d;
    color: #ede9fe;
    border: round #7c3aed;
    text-style: bold;
}

.boton-control:hover {
    background: #4c2a80;
    border: round #a78bfa;
}

.boton-control:focus {
    background: #6d28d9;
    border: round #c4b5fd;
    color: #ffffff;
}

.boton-control:disabled {
    color: #5b4a78;
    border: round #3b1d63;
}
